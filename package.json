{
  "name": "naseeb-giveaways",
  "version": "1.0.0",
  "description": "Free-entry giveaway platform (no-purchase-necessary model)",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node scripts/reset-test-db.js && node --test --test-concurrency=1",
    "test:db:start": "scripts/test-db.sh start",
    "test:db:stop": "scripts/test-db.sh stop",
    "test:db:destroy": "scripts/test-db.sh destroy",
    "db:init": "node -e \"require('./server/db').init().then(() => process.exit(0))\"",
    "test:browser-security": "node scripts/browser-hostile-data.js",
    "maintenance": "node scripts/maintenance.js",
    "migrate": "node scripts/migrate.js",
    "backup:verify": "node scripts/backup-verify.js",
    "schema:snapshot": "node scripts/schema-snapshot.js",
    "rehearse:giveaway": "node scripts/rehearsal-giveaway.js",
    "test:accessibility": "node scripts/browser-accessibility.js"
  },
  "dependencies": {
    "@sentry/node": "^10.68.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "pg": "^8.11.5",
    "stripe": "^22.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "playwright-core": "1.55.0",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": "22.x"
  },
  "files": [
    "server/",
    "public/",
    "scripts/",
    "docs/",
    "README.md",
    "render.yaml"
  ]
}
