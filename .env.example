PORT=3000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Sessions and CSRF
# ---------------------------------------------------------------------------
# Browser authentication is an opaque session token in an HttpOnly cookie, with
# only its SHA-256 hash stored in Postgres. It used to be a 30-day JWT in
# localStorage sent back as a bearer header — readable by any script on the
# page, impossible to revoke, and invisible to the server. See docs/SESSIONS.md.
#
# SESSION_SECRET signs the CSRF tokens. REQUIRED: in production the app refuses
# to start without it, or with one shorter than 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changing it invalidates every issued CSRF token, so every open page has to be
# reloaded once. It does not sign session tokens, so sessions themselves survive.
SESSION_SECRET=

# How long a session lasts, from sign-in. Default 12, clamped to 1–168 (one
# hour to seven days) so no value can restore the old month-long behaviour.
# There is no sliding extension: a session ends when it ends.
SESSION_TTL_HOURS=12

# How long one token value is used before the next request quietly swaps it for
# a fresh one. Does not extend the session. Default 240 (four hours); a replaced
# token keeps working for 60 seconds so browser tabs mid-request are not signed
# out. Minimum 5.
SESSION_ROTATE_AFTER_MINUTES=240

# Development only. The session cookie is Secure in production ALWAYS — the app
# refuses to start if this says otherwise, or if APP_URL is not https. Set it to
# true locally only if you are serving over https; a Secure cookie is never sent
# over plain http, so local http development needs this off (the default).
COOKIE_SECURE=false

# SESSION_SECRET has NO default and NO fallback. Production refuses to start on
# a value that is missing, under 32 characters, a recognisable placeholder, made
# of too few distinct characters, or identical to JWT_SECRET / APP_URL /
# DATABASE_URL / STRIPE_SECRET_KEY / CLAIM_ENCRYPTION_KEY. Only the variable
# NAME is ever printed — no value is echoed into a log or an error.
#
# JWT_SECRET is gone: the `jsonwebtoken` dependency has been removed and nothing
# reads that variable any more. Delete it from your environment.

# Optional. 'true' forces SSL, 'false' disables it. When unset, SSL is enabled
# for every host except localhost/127.0.0.1 — which is what hosted Postgres
# (Neon, Supabase, Render) needs, so most deployments can leave this alone.
DATABASE_SSL=

# Public URL this app is served at. Used for three things now:
#   * building links in emails (verification, password reset, claim invitations)
#   * the CORS origin
#   * the ONLY Origin/Referer accepted on state-changing API requests
# Get it wrong and every write from the real site is refused with 403
# ORIGIN_NOT_ALLOWED, which is the safe direction to be wrong in. Must be https
# in production. Use http://localhost:3000 for local dev.
APP_URL=http://localhost:3000

# Email delivery.
#
# LOCAL DEVELOPMENT: leave RESEND_API_KEY empty. The console logger is the
# transport — every message is printed instead of sent, which is how the whole
# test suite exercises signup, password reset, claim invitations and email
# changes without a provider account.
#
# PRODUCTION: both are REQUIRED and the process refuses to start without them.
# Verification, password recovery, claim invitations, email-change verification
# and the old-address security warning are core workflows, and a deployment that
# cannot send them and reports itself healthy is lying. `private_beta` does not
# exempt it — a beta with real accounts in it is a deployment where somebody
# will need to recover a password.
RESEND_API_KEY=
# Sender identity. Shape-validated in production: the value below uses the
# provider's shared onboarding domain, which is fine for local development and
# is REFUSED in production — it cannot be verified, cannot be replied to, and
# delivers poorly. Set a sender on a domain you have verified. Reserved example
# domains are refused too. The value is never printed, logged or echoed.
EMAIL_FROM=Naseeb <onboarding@resend.dev>
# Where "new host application" notifications are sent.
ADMIN_NOTIFY_EMAIL=

# Temporary email maintenance mode, for a planned provider migration.
#
# DEFAULTS TO ON. An unset, empty or misspelled value means "email is expected
# to work" — never "quietly stop sending". Only an explicit false/0/no/off
# turns it off.
#
# While off, signup, resend verification, password reset, email change, the
# winner draw and claim-invitation reissue return 503 EMAIL_DELIVERY_UNAVAILABLE
# BEFORE creating the state that email was supposed to complete — no
# unverifiable account whose address is now taken, no pending change that blocks
# the next attempt, no live reset token nobody asked for, no winner who can
# never be told. Existing sessions are untouched. Refused at public launch.
# EMAIL_DELIVERY_ENABLED=false

# How many notifications may reach TERMINAL failure in 24 hours before /readyz
# reports the platform degraded. Not zero: one address that hard-bounces is a
# customer-service matter, a cluster of them is an outage. Default 5.
# NOTIFICATION_FAILURE_THRESHOLD=5

# How many proxies sit in front of this process, and therefore how much of
# X-Forwarded-For may be believed. With N hops, Express reads the (N+1)-th
# address from the right — a client can prepend anything, but cannot control the
# entry the last trusted proxy appends.
#
#   0  nothing in front (local development). Forwarding headers are ignored.
#   1  Render, or any single reverse proxy / TLS terminator.
#
# Getting this too HIGH makes every rate limit spoofable: a script sends a
# different forged address each request and never shares a bucket with itself.
# Too low means one shared bucket, which is a usability problem rather than a
# security one — so the default is 0 and production assumes 1.
TRUSTED_PROXY_HOPS=0

# Keys the network hashes in the entry-integrity tables. Raw IP addresses are
# never stored anywhere; a coarse prefix is HMAC'd with this secret and the
# current retention window, so the value cannot be reversed and rows stop
# linking once the window turns over. Rotating this breaks linkage immediately.
#
# Production refuses to start on a missing, short, placeholder, low-entropy or
# borrowed value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRITY_SIGNAL_SECRET=

# How long a risk signal is kept, in days (1–90, default 30). Also the length of
# the hash window, so a shorter retention also means shorter linkability.
INTEGRITY_SIGNAL_RETENTION_DAYS=30

# Optional: without these, image upload is hidden and hosts paste a URL instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Extra origins images and video may be loaded from, comma-separated, full
# https origins only (e.g. https://cdn.example.com,https://media.example.com).
# https://res.cloudinary.com is always allowed and does not need listing here.
#
# This is one list with two consumers: the server rejects a stored image URL
# whose origin is not on it, and the same list becomes img-src/media-src in the
# Content-Security-Policy. Adding an origin here therefore grants it on both
# sides at once — read docs/CSP.md §6 before adding one.
MEDIA_ORIGIN_ALLOWLIST=

# Self-serve ad checkout (Stripe). DISABLED unless this is explicitly set to
# true/1/yes/on — an absent, empty or misspelled value fails closed, and the
# advertise page falls back to its manual inquiry form.
#
# Leave this off until booking-reservation concurrency and price parity are
# also covered by passing tests. Until then, two customers can still be sold
# the same dates, and the page can display a different price from the one
# Stripe charges.
ADS_CHECKOUT_ENABLED=false

# Stripe. Both are REQUIRED when ADS_CHECKOUT_ENABLED is on — the app refuses
# to start without them, because taking payments with no verified webhook means
# customers get charged for bookings nothing ever marks as paid.
#
# STRIPE_SECRET_KEY:  sk_test_... while testing, sk_live_... in production.
# STRIPE_WEBHOOK_SECRET: the signing secret for THIS endpoint, shown once when
#   you add the endpoint in the Stripe dashboard, and different per environment.
#   It is not the API key and cannot be looked up again later — rotate it in the
#   dashboard if it is lost.
#
# Endpoint to register in Stripe:  https://your-domain/api/webhooks/stripe
# Events to subscribe:
#   checkout.session.completed
#   checkout.session.async_payment_succeeded
#   checkout.session.async_payment_failed
#   checkout.session.expired
#   charge.refunded
#   charge.dispute.created
#
# Local testing without a real endpoint:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# which prints a whsec_... for that session only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The test suite never reads this file — it reads .env.test (gitignored), or
# real environment variables in CI. That separation is deliberate: it is what
# stops `npm test` from connecting to the production database above.
#
# Put this in .env.test, not here:
#
#   TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55432/naseeb_test
#
# `npm run test:db:start` creates exactly that database locally and prints the
# line to copy. The database name must contain "test" and the host must be
# local, or the suite refuses to run (see testEnv.js).

# ---------------------------------------------------------------------------
# Prize claims (winner delivery workflow)
# ---------------------------------------------------------------------------
# CLAIMS_ENABLED defaults to ON. It exists so an operator who has not generated
# an encryption key yet can still run the site; set it to false to do that.
CLAIMS_ENABLED=true

# REQUIRED while claims are enabled — in production the app refuses to start
# without it. Winner delivery details (name, phone, address) are encrypted with
# AES-256-GCM using this key before they reach the database.
#
# Format is "version:base64key", where the key is 32 random bytes. Generate one:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
#
# Losing this key means every stored delivery detail becomes permanently
# unreadable. Back it up somewhere separate from the database backups.
CLAIM_ENCRYPTION_KEY=

# Decrypt-only keys, for reading records written before a rotation. Comma
# separated, same "version:base64key" format. To rotate: move the current value
# of CLAIM_ENCRYPTION_KEY here, generate a new one with a new version, deploy.
# Nothing needs re-encrypting — existing records stay readable under their old
# key until retention erases them, and new records use the new key. Remove an
# old key from this list once no record still references its version.
CLAIM_ENCRYPTION_KEYS_PREVIOUS=

# How long a claim link stays valid. Short by design: it is a bearer credential.
CLAIM_TOKEN_TTL_HOURS=72

# How long encrypted delivery details are kept after a delivery is confirmed or
# a dispute is resolved, in days. PROVISIONAL — pending UAE counsel review.
CLAIM_DELIVERY_RETENTION_DAYS=30

# Development only, ignored in production. Claim invitation emails are normally
# suppressed from the dev console because their body contains a working
# single-use link. Set this to true locally if you need to click one.
CLAIM_DEV_LOG_LINKS=false

# How often the IN-PROCESS scheduler runs claim expiry, delivery-detail erasure
# and both outboxes. It has no HTTP route, so there is nothing for the public to
# invoke; only one instance does the work per tick.
#
# This is a SAFETY NET, not the schedule. A timer inside a web process stops
# when the process sleeps, and on a free plan the web service sleeps — so the
# real schedule is `node scripts/maintenance.js`, run by the platform. See
# docs/OPERATIONS.md.
CLAIM_MAINTENANCE_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

# production only in production. Selects strict startup validation, HSTS, and a
# refusal to enable the development mail logger. Leave unset locally.
# NODE_ENV=production

# What this deployment IS. One of: development | staging | private_beta |
# public_launch.
#
# Unset means development locally and private_beta in production — never
# public_launch by omission. `public_launch` asserts the legal work is done and
# will REFUSE TO START today: both policies are drafts with no effective date
# and their blockers are outstanding. Do not set it in any committed file.
# DEPLOYMENT_STATE=private_beta

# Upper bound on rows a single maintenance job pass touches. A job that tries to
# delete a year of rows in one statement holds locks for minutes and times out
# having achieved nothing. Re-run until a pass returns less than this.
MAINTENANCE_BATCH_LIMIT=500

# How long a graceful shutdown may take before the process gives up and exits
# non-zero. Must be comfortably under the platform's own SIGKILL grace period.
SHUTDOWN_TIMEOUT_MS=20000

# ---------------------------------------------------------------------------
# Error reporting and analytics — both optional, with a stated consequence
# ---------------------------------------------------------------------------

# Sentry. Optional: without it the application runs identically and errors reach
# the platform log only, which means nothing alerts and a failure at 3am is
# discovered by a person noticing. Everything sent is scrubbed first — see
# server/lib/errorReporting.js. Startup WARNS in production when it is unset,
# and does not refuse.
SENTRY_DSN=

# Google Analytics. Optional: without it there is no traffic measurement at all.
# Never loaded on the account, prize-claim, email-change, admin or owner pages.
GA_MEASUREMENT_ID=
